{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "school_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "templateFor": "lib/",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8081"
            ]
        },
        {
            "name": "school_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8081"
            ]
        },
        {
            "name": "school_app (release mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8081"
            ]
        },
        {
            "name": "Dart: Run all Tests",
            "type": "dart",
            "request": "launch",
            "program": "./test/"
        }
    ]
}
